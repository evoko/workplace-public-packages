    "rules": [
      {
        "rule": "base",
        "at": "base",
        "reason": "One tab of a Tabs strip. MUI's Tab on the web, for a tablist's keyboard: its Tabs moves the focus from tab to tab with the arrow keys, and Enter or Space selects (owner decision 2026-09-24: arrows move the focus, as SOLAR's description says, since a selected tab is the routed one). Its icons, words and Counter are drawn with the shared layer helpers. Bespoke in Flutter, drawn and pressable, announced as a tab, selected where it is."
      },
      {
        "rule": "follows",
        "at": "root.borderBottomWidth",
        "reason": "The selected tab's underline is its state's, 2px under the selected and the focused tab, as Figma draws each; a tab at rest has none."
