  "docs": {
    "description": "Progress indicator for a linear multi-step flow — wizard, onboarding, device setup. 4 variants: type (line, with label, no label, line+text). Booleans showStep3, showStep4, showStep5 set the step count (2–5). Steps are informational unless the flow allows going back, in which case completed steps are links. Back/next buttons belong to the Multi-step Wizard pattern, not to Stepper. For non-linear sections use Tabs.",
    "figmaIssues": []
  },
  "provenance": {
    "page": "components/navigation",
    "pageId": "2163:3707",
    "figmaNode": "5762:5846",
    "defaultVariant": "type=with label",
    "fileVersion": "2402761872194862831"
  },
  "overlay": {
    "file": "spec/overlay/stepper.yaml",
    "rules": [
      {
        "rule": "base",
        "at": "base",
        "reason": "A linear flow's progress, its description says: two to five steps, the active one announced (`aria-current=\"step\"`), in one of four looks: round Steps over a progress bar (with label), Stepper Indicators joined by lines (no label), a bar of segments (line), or horizontal Steps (line+text). It takes its steps' labels and the active one's index (owner decision 2026-09-24), and draws each part in the layer Figma draws for its status; completed steps are buttons where it is given `onStepClick` (owner decision 2026-09-24). Drawn with the shared layer helpers on both platforms."
      },
      {
        "rule": "follows",
        "at": "root.align",
        "reason": "As its direction, by type."
      },
      {
        "rule": "follows",
        "at": "root.direction",
        "reason": "With label, the stepper stacks its bar and its steps; the other types lay their parts out in one row, as Figma draws each."
      },
      {
        "rule": "follows",
        "at": "root.gap",
        "reason": "As its direction, by type, each type's gap its own."
      },
      {
        "rule": "follows",
        "at": "root.height",
        "reason": "As its direction, by type."
      },
      {
        "rule": "set",
        "at": "progress.base.paddingRight",
        "reason": "The progress bar's 225px right padding is Figma presentation only (design team, 2026-09-24), the room its sample fill leaves: not reproduced. The shell draws the fill's width from the active step."
      },
      {
        "rule": "set",
        "at": "root.appearance.type=line.default.height",
        "reason": "The line stepper is as tall as its segments: Figma fixes it at their 4px, bound to nothing."
      },
      {
        "rule": "set",
        "at": "step.appearance.type=line+text.default.variant.status",
        "reason": "Figma draws the line+text stepper's second step upcoming after a complete first, with no step active; a stepper always has one (its active index), the step after the completed ones. The design review asks SOLAR to draw it."
      },
      {
        "rule": "set",
        "at": "stepCompleteHorizontal.base.variant.status",
        "reason": "As its name says, the first step complete."
      },
      {
        "rule": "set",
        "at": "stepCompleteHorizontal.base.variant.type",
        "reason": "As its name says, a horizontal Step."
      },
      {
        "rule": "set",
        "at": "stepperIndicator.base.height",
        "reason": "A step's circle is a SOLAR Stepper Indicator, whose 24px is its own."
      },
      {
        "rule": "set",
        "at": "stepperIndicator.base.width",
        "reason": "A step's circle is a SOLAR Stepper Indicator, whose 24px is its own."
      },
      {
        "rule": "set",
        "at": "stepperIndicator2.base.height",
        "reason": "A step's circle is a SOLAR Stepper Indicator, whose 24px is its own."
      },
      {
        "rule": "set",
        "at": "stepperIndicator2.base.width",
        "reason": "A step's circle is a SOLAR Stepper Indicator, whose 24px is its own."
      },
      {
        "rule": "set",
        "at": "stepperIndicator3.base.height",
        "reason": "A step's circle is a SOLAR Stepper Indicator, whose 24px is its own."
      },
      {
        "rule": "set",
        "at": "stepperIndicator3.base.width",
        "reason": "A step's circle is a SOLAR Stepper Indicator, whose 24px is its own."
      },
      {
        "rule": "allowLiteral",
        "at": "frame.height",
        "reason": "A line between two circles is 2px thick, bound to nothing (as the bar's, no token)."
      },
      {
        "rule": "allowLiteral",
        "at": "frame2.height",
        "reason": "As the first line's, 2px."
      },
      {
        "rule": "allowLiteral",
        "at": "progress.height",
        "reason": "The bar is 4px thick, bound to nothing: SOLAR has no line-thickness token beside its border widths (the design review's question on sizes with no variable)."
      },
      {
        "rule": "allowLiteral",
        "at": "progressRectangle2.height",
        "reason": "As the bar's, 4px."
      },
      {
        "rule": "allowLiteral",
        "at": "rectangle1.height",
        "reason": "As the progress bar's, a segment 4px thick."
      },
      {
        "rule": "allowLiteral",
        "at": "rectangle2.height",
        "reason": "As the progress bar's, a segment 4px thick."
      },
      {
        "rule": "allowLiteral",
        "at": "rectangle3.height",
        "reason": "As the progress bar's, a segment 4px thick."
      },
      {
        "rule": "allowLiteral",
        "at": "rectangle4.height",
        "reason": "As the progress bar's, a segment 4px thick."
      },
      {
        "rule": "allowLiteral",
        "at": "rectangle5.height",
        "reason": "As the progress bar's, a segment 4px thick."
      },
      {
        "rule": "controlDraws",
        "at": "progress",
        "reason": "The bar spans the stepper under its steps, drawn by the shell from edge to edge (the first and last circles cover its ends): Figma places it 313 wide, 18 from the right, a sample of the stepper's width. Its height, corners, colour and its place from the top are the recipe's.",
        "cells": ["x", "right", "width"]
      },
      {
        "rule": "controlDraws",
        "at": "progressRectangle2",
        "reason": "The bar's fill reaches the active step, a share of the bar the shell draws: Figma's 153 is its sample, the second of three.",
        "cells": ["width"]
      },
      {
        "rule": "accept",
        "at": "component.stepper.root.paddingBottom@type=line",
        "reason": "As the first, the same 0."
      },
      {
        "rule": "accept",
        "at": "component.stepper.root.paddingBottom@type=line+text",
        "reason": "As the first, the same 0."
      },
      {
        "rule": "accept",
        "at": "component.stepper.root.paddingBottom@type=no label",
        "reason": "As the first, the same 0."
      },
      {
        "rule": "accept",
        "at": "component.stepper.root.paddingLeft@type=line",
        "reason": "As the first, the same 0."
      },
      {
        "rule": "accept",
        "at": "component.stepper.root.paddingLeft@type=line+text",
        "reason": "As the first, the same 0."
      },
      {
        "rule": "accept",
        "at": "component.stepper.root.paddingLeft@type=no label",
        "reason": "As the first, the same 0."
      },
      {
        "rule": "accept",
        "at": "component.stepper.root.paddingRight@type=line",
        "reason": "As the first, the same 0."
      },
      {
        "rule": "accept",
        "at": "component.stepper.root.paddingRight@type=line+text",
        "reason": "As the first, the same 0."
      },
      {
        "rule": "accept",
        "at": "component.stepper.root.paddingRight@type=no label",
        "reason": "As the first, the same 0."
      },
      {
        "rule": "accept",
        "at": "component.stepper.root.paddingTop@type=line",
        "reason": "Figma binds this type's padding to inset.none and leaves the with label type's an unbound 0, which the shared default binds to inset.none: the same 0."
      },
      {
        "rule": "accept",
        "at": "component.stepper.root.paddingTop@type=line+text",
        "reason": "As the first, the same 0."
      },
      {
        "rule": "accept",
        "at": "component.stepper.root.paddingTop@type=no label",
        "reason": "As the first, the same 0."
      },
      {
        "rule": "composes",
        "at": "Step/complete/horizontal → Step",
        "reason": "The line+text stepper's first step is an instance of the Step variant itself, named by its variant (`Step/complete/horizontal`): it is a Step, complete and horizontal."
      },
      {
        "rule": "bind",
        "at": "root.gap",
        "reason": "Same value, governed token: a gap Figma leaves unbound at 0 is the none of its family, and SOLAR picks the family by direction, as its own bound gaps do: a horizontal auto layout's gap is an inset, a vertical one's a stack (the Foundations agent reference and the Spatial chapter). Decided once here, as the paddings are.",
        "from": "spec/overlay/defaults.yaml",
        "default": "zero-gaps"
      },
      {
        "rule": "bind",
        "at": "root.paddingTop, root.paddingRight, root.paddingBottom, root.paddingLeft, progress.paddingTop, progress.paddingBottom, progress.paddingLeft, steps.paddingTop, steps.paddingRight, steps.paddingBottom, steps.paddingLeft",
        "reason": "Same value, governed token: a padding Figma leaves unbound at 0 is inset.none, SOLAR's token for no inset. It is the one answer in every component, so it is decided once here and raised with SOLAR once, as a whole, not per component.",
        "from": "spec/overlay/defaults.yaml",
        "default": "zero-insets"
      }
    ]
  }
