  "docs": {
    "description": "Transient notification for background operation results. Appears top-right or bottom-right and auto-dismisses after 4–7s (danger longer). 5 variants: status (neutral, success, warning, danger, info); each carries a standard status Tag of its own status. Props: show Action, show Chevron. Use for async outcomes (“File saved”, “Connection lost”); never for critical errors that need confirmation — use Dialog. See also: Alert for inline callouts, Banner for page-level messages.",
    "figmaIssues": []
  },
