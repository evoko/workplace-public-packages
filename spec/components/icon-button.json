  "overlay": {
    "file": "spec/overlay/icon-button.yaml",
    "rules": [
      {
        "rule": "base",
        "at": "base",
        "reason": "The closest stock control on each platform. MUI IconButton takes loading and disabled and supplies focus handling and keyboard activation; Flutter's IconButton takes a ButtonStyle, as FilledButton does for Button, so the same style builder restyles it."
      },
      {
        "rule": "follows",
        "at": "root.radius",
        "reason": "What the shape axis is for: square takes radius.control and round radius.pill, at every size, priority and state."
      },
      {
        "rule": "bind",
        "at": "icon.height",
        "reason": "Same values, governed tokens, one step of the icon ladder per size; the icon's width is already bound to them."
      },
      {
        "rule": "bind",
        "at": "root.height",
        "reason": "As Button's height: size.control, one step per size, which SOLAR added on 2026-09-25; Figma leaves the height unbound, which the design review asks SOLAR to bind."
      },
      {
        "rule": "allowLiteral",
        "at": "root.width",
        "reason": "An icon button is square, so its width is its height, under the same decision."
      },
      {
        "rule": "slots",
        "at": "iconNone → icon",
        "reason": "The icon is what an icon button is for, and the caller gives it. Figma draws the Icon/None placeholder and swaps the instance, recording no prop, so it is declared here."
      },
      {
        "rule": "bind",
        "at": "root.gap",
        "reason": "Same value, governed token: a gap Figma leaves unbound at 0 is the none of its family, and SOLAR picks the family by direction, as its own bound gaps do: a horizontal auto layout's gap is an inset, a vertical one's a stack (the Foundations agent reference and the Spatial chapter). Decided once here, as the paddings are.",
        "from": "spec/overlay/defaults.yaml",
        "default": "zero-gaps"
      },
      {
        "rule": "bind",
        "at": "root.paddingTop, root.paddingRight, root.paddingBottom, root.paddingLeft",
        "reason": "Same value, governed token: a padding Figma leaves unbound at 0 is inset.none, SOLAR's token for no inset. It is the one answer in every component, so it is decided once here. SOLAR decided on 2026-09-25 to leave the zeros unbound, since binding them changes nothing drawn, and to have them read this way.",
        "from": "spec/overlay/defaults.yaml",
        "default": "zero-insets"
      }
    ]
  }
