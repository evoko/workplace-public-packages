  "docs": {
    "description": "Expand/collapse cell and connector for expandable Table rows. 6 variants: type (title-row, collapsed, expanded, middle-row, bottom-row, vertical-only) — the chevron cell on the parent row plus the connector segments drawn beside its child rows. Internal building block of Row and Table.",
    "figmaIssues": []
  },
  "provenance": {
    "page": "components/data-display",
    "pageId": "2163:3683",
