  },
  "overlay": {
    "file": "spec/overlay/rowexpand.yaml",
    "rules": [
      {
        "rule": "base",
        "at": "base",
        "reason": "Bespoke on both platforms: a table row's expand cell and the connector drawn beside its child rows, drawn from its layers. Decorative on its own: a top Row draws it as its expand button, which says whether the group is shown (aria-expanded), and a flat row's cell is drawn empty (no chevron), as Figma hides it there."
      },
      {
        "rule": "drawing",
        "at": "every cell",
        "reason": "Each type is its own drawing: the title row an empty cell, collapsed and expanded a chevron, and the bottom, middle and vertical-only rows a connector of their own, one or two vectors placed by position with no auto layout. So every cell follows the type."
      },
      {
        "rule": "bind",
        "at": "iconChevronDown.width",
        "reason": "As the right chevron's."
      },
      {
        "rule": "bind",
        "at": "iconChevronRight.width",
        "reason": "Same value, governed token; Figma binds the chevron's height to icon.sm already."
      },
      {
        "rule": "bind",
        "at": "root.width",
        "reason": "The cell is the width of its chevron, an icon.sm (16px), the same value, so the connector lines up with the chevron above it."
      },
      {
        "rule": "allowLiteral",
        "at": "root.height",
        "reason": "A table row's height, 40, bound to nothing: SOLAR publishes no row height. Raised as a governance gap."
      }
    ]
  }
