    "fileVersion": "2403086052040245261"
  },
  "derived": {
    "type": {
      "values": ["icon", "extended"],
      "default": "icon",
      "when": [
        {
          "value": "extended",
          "given": ["label"]
        },
        {
          "value": "icon",
          "given": []
        }
      ],
      "reason": "An extended FAB is one with a label (\"extended type gets its name from the visible label\", says the description): the type follows from whether the caller gives one, so it is no prop the caller could set against its content, and no clash with a button's HTML type."
    }
  },
  "overlay": {
    "file": "spec/overlay/fab.yaml",
    "rules": [
      {
        "rule": "base",
        "at": "base",
        "reason": "MUI's Button, not its Fab: SOLAR's FAB has a loading state, which MUI's Button draws (its loading indicator, the content keeping its room) and MUI's Fab does not, and Fab's own size, elevation and upper-case label are all SOLAR's to set. Flutter's FilledButton, as for Button, restyled by the same ButtonStyle builder; where it floats is the app's (a Scaffold's floatingActionButton takes any widget)."
      },
      {
        "rule": "follows",
        "at": "icon.height",
        "reason": "As the width."
      },
      {
        "rule": "follows",
        "at": "icon.width",
        "reason": "An extended FAB's icon is 24px (icon.lg), an icon FAB's 20px (icon.md), at both sizes."
      },
      {
        "rule": "follows",
        "at": "root.gap",
        "reason": "The gap between the icon and the label, which an icon FAB does not have."
      },
      {
        "rule": "follows",
        "at": "root.paddingRight",
        "reason": "An extended FAB pads its label's side more than its icon's (inset.lg and inset.xl, beside inset.sm and inset.md), as an extended FAB's pill is balanced; an icon FAB is padded evenly."
      },
      {
        "rule": "follows",
        "at": "root.width",
        "reason": "An icon FAB is a fixed circle (44 and 56); an extended one is a pill that hugs its icon and label."
      },
      {
        "rule": "bind",
        "at": "icon.height",
        "reason": "Same value, governed token: an extended FAB's icon is 24 tall and bound to nothing, and 24 wide bound to icon.lg."
      },
      {
        "rule": "bind",
        "at": "icon.width",
        "reason": "Same value, governed token: an icon FAB's icon is 20 wide and bound to nothing, and 20 tall bound to icon.md."
      },
      {
        "rule": "allowLiteral",
        "at": "root.height",
        "reason": "Drawn 44 and 56, as the description says, bound to nothing: neither is one of SOLAR's control heights (size.control: 32, 40, 48), so carried as drawn; the design review asks."
      },
      {
        "rule": "allowLiteral",
        "at": "root.width",
        "reason": "An icon FAB is a circle, so its width is its height, under the same decision."
      },
      {
        "rule": "accept",
        "at": "component.fab.label.width@type=extended, state=loading",
        "reason": "Loading hides the label, keeping its room: Figma sizes the hidden words to hug, where the shown ones fill the FAB, which draws nothing either way. The label fills in every state."
      },
      {
        "rule": "accept",
        "at": "component.fab.root.paddingRight@state=loading",
        "reason": "As its width, the loading FAB keeps the padding it has at rest."
      },
      {
        "rule": "accept",
        "at": "component.fab.root.width@state=loading",
        "reason": "A loading FAB keeps its size, the label hidden but keeping its room, as Button's does, so it does not shrink under the pointer. Figma's loading extended FAB is 7 and 8px narrower (84 and 104, beside 91 and 112) and padded evenly, which looks like an accident; the design review lists it."
      },
      {
        "rule": "slots",
        "at": "iconNone → icon",
        "reason": "The icon is the action (add, compose, scan), and the caller gives it. Figma draws the Icon/None placeholder and records no prop, so it is declared here, as Icon Button's is."
      },
      {
        "rule": "derive",
        "at": "type",
        "reason": "An extended FAB is one with a label (\"extended type gets its name from the visible label\", says the description): the type follows from whether the caller gives one, so it is no prop the caller could set against its content, and no clash with a button's HTML type."
      },
      {
        "rule": "bind",
        "at": "root.gap",
        "reason": "Same value, governed token: a gap Figma leaves unbound at 0 is the none of its family, and SOLAR picks the family by direction, as its own bound gaps do: a horizontal auto layout's gap is an inset, a vertical one's a stack (the Foundations agent reference and the Spatial chapter). Decided once here, as the paddings are.",
        "from": "spec/overlay/defaults.yaml",
        "default": "zero-gaps"
      }
    ]
