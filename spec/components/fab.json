  "docs": {
    "description": "Floating Action Button — the single most important action on a screen, elevated above content. 24 variants: type (icon, extended) × size (sm 44px, md 56px) × state (default, hover, pressed, focus, disabled, loading). Uses action/primary tokens + shadow/raised; focus replaces the lift with shadow/focus/default. loading keeps the resting width. extended adds a label for discoverability. One FAB per screen.",
    "figmaIssues": []
  },
  "provenance": {
    "page": "components/buttons",
    "pageId": "2966:581",
