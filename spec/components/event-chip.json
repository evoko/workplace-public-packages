  "docs": {
    "description": "Event chip used in Day Cell, Week/Day grid, and Agenda Row. Subtle = neutral surface with a colored category stripe; solid = full category fill with inverse text. Both densities (md, sm) support all 8 category colors.",
    "figmaIssues": []
  },
  "provenance": {
    "page": "components/calendar",
    "pageId": "6622:5",
    "figmaNode": "6632:2",
    "defaultVariant": "category=red, style=subtle",
    "fileVersion": "2403086052040245261"
  },
  "overlay": {
    "file": "spec/overlay/event-chip.yaml",
    "rules": [
      {
        "rule": "base",
        "at": "base",
        "reason": "One event in a calendar (a Day Cell, a week or day grid, an Agenda Row), as the description says: its category's colour, as a stripe beside neutral words (subtle), a pale fill (tinted) or a full fill with inverse words (solid), its time, a repeating event's icon, and its title. A styled part, as the calendar family is (decision): what an event is, and what a click on it does, are the caller's."
      },
      {
        "rule": "rename",
        "at": "style",
        "reason": "Rule 5's one exception, as Alert's (owner decision 2026-09-25): `style` is React's inline-style prop, so no component can take it, and `variant` names the look on both platforms. The design review asks Figma to rename the property `variant`, so the names match."
      },
      {
        "rule": "follows",
        "at": "root.align",
        "reason": "Figma aligns a tinted chip's content to its top where the others centre it; the content fills the chip's height, so no chip draws the difference. Drawn as Figma aligns each; the design review lists it."
      },
      {
        "rule": "follows",
        "at": "root.radius",
        "reason": "A subtle chip is square beside its stripe (radius.none); a tinted or solid chip, a filled box, is rounded (radius.control), as Figma draws each."
      },
      {
        "rule": "follows",
        "at": "stripe.height",
        "reason": "The stripe runs the chip's height in a subtle chip. A tinted or solid chip hides it, and no prop shows it there, so what Figma keeps on it there (a fixed 22, no radius, from before it was hidden) is never drawn: it follows the style, as its presence does."
      },
      {
        "rule": "follows",
        "at": "stripe.radius",
        "reason": "The stripe runs the chip's height in a subtle chip. A tinted or solid chip hides it, and no prop shows it there, so what Figma keeps on it there (a fixed 22, no radius, from before it was hidden) is never drawn: it follows the style, as its presence does."
      },
      {
        "rule": "follows",
        "at": "title.typography",
        "reason": "A solid chip's title is semibold (body/sm/semibold), inverse on its full fill, where the others' is medium, as Figma draws each: its weight follows the style, not the category."
      },
      {
        "rule": "bind",
        "at": "repeating.width",
        "reason": "Same value, governed token; the icon's height is already bound to it."
      },
      {
        "rule": "set",
        "at": "root.base.width",
        "reason": "A chip fills the width its cell, grid column or row gives it: Figma draws a 160 sample, and a Day Cell stretches its chips across."
      },
      {
        "rule": "allowLiteral",
        "at": "root.height",
        "reason": "A chip is 22 tall, bound to nothing: SOLAR has no size for it, one of the sizes with no variable (a calendar's row)."
      },
      {
        "rule": "allowLiteral",
        "at": "stripe.height",
        "reason": "The 22 Figma keeps on the stripe where a tinted or solid chip hides it, never drawn (follows stripe.height); where it is drawn it fills the chip."
      },
      {
        "rule": "allowLiteral",
        "at": "stripe.width",
        "reason": "The stripe is 3 wide, bound to nothing: no border width is 3 (border.strong is 2), and a stripe is a fill, not an edge."
      },
      {
        "rule": "bind",
        "at": "root.gap",
        "reason": "Same value, governed token: a gap Figma leaves unbound at 0 is the none of its family, and SOLAR picks the family by direction, as its own bound gaps do: a horizontal auto layout's gap is an inset, a vertical one's a stack (the Foundations agent reference and the Spatial chapter). Decided once here, as the paddings are.",
        "from": "spec/overlay/defaults.yaml",
        "default": "zero-gaps"
      },
      {
        "rule": "bind",
        "at": "root.paddingTop, root.paddingRight, root.paddingBottom, root.paddingLeft",
        "reason": "Same value, governed token: a padding Figma leaves unbound at 0 is inset.none, SOLAR's token for no inset. It is the one answer in every component, so it is decided once here. SOLAR decided on 2026-09-25 to leave the zeros unbound, since binding them changes nothing drawn, and to have them read this way.",
        "from": "spec/overlay/defaults.yaml",
        "default": "zero-insets"
      }
    ]
  }
