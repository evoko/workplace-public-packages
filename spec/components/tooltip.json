    "file": "spec/overlay/tooltip.yaml",
    "rules": [
      {
        "rule": "base",
        "at": "base",
        "reason": "A brief label shown on hover or keyboard focus, as the description says: the drawn bubble and its arrow, pointing at its trigger from the side `position` names (top by default), after a hover delay (motion.duration.slow, the nearest duration to the description's ~500ms), never holding the focus, describing its trigger (aria-describedby). MUI's Tooltip on the web, its title the drawn bubble; in Flutter drawn in an overlay (owner decision 2026-09-25: Flutter's Tooltip draws no arrow), shown on hover, long press or focus. Without a trigger it is the bubble alone, drawn in place, as the visual checks draw it."
      },
      {
        "rule": "follows",
        "at": "arrow.height",
        "reason": "The arrow is 7 × 3 pointing up or down (top, bottom) and 3 × 7 pointing sideways (right, left): its box turns with it."
