        "rule": "set",
        "at": "root.base.width",
        "reason": "A field spans its container, as a form row lays it out: Figma draws it 240 wide (md) and 160 (sm), samples. The caller sizes it, as a Text Input."
      },
      {
        "rule": "set",
        "at": "root.size.sm.width",
        "reason": "As md's, the sm field's 160 a sample."
      },
      {
        "rule": "set",
        "at": "tag.base.height",
        "reason": "The tokens are SOLAR Tags, whose height is their own: the field lays them out and never sizes them."
      },
      {
        "rule": "set",
        "at": "tag2.base.height",
        "reason": "As the first token's."
