    "file": "spec/overlay/token-input.yaml",
    "rules": [
      {
        "rule": "base",
        "at": "base",
        "reason": "Bespoke on both: a field of entries, which it holds (owner decision 2026-09-24: `value` is its string list), each drawn as a SOLAR Tag, neutral and closable, and the ones past `maxVisible` counted by a SOLAR Counter. Its input, where the next entry is typed, is MUI's InputBase on the web and an undecorated TextField in Flutter. No stock control draws SOLAR's tokens."
      },
      {
        "rule": "follows",
        "at": "addItems.present",
        "reason": "The input stays, in every state but read-only and disabled, so the next entry can be typed: Figma hides its words once there are entries, which is the placeholder going (the code shows it only while there are none). The accept rules below say so for each state."
      },
      {
        "rule": "set",
        "at": "counter.base.height",
        "reason": "The Counter's height is its own, as the Tags' are."
      },
