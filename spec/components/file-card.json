  },
  "overlay": {
    "file": "spec/overlay/file-card.yaml",
    "rules": [
      {
        "rule": "base",
        "at": "base",
        "reason": "Bespoke on both: a tile of the card family (shells/card.mjs), one file of a file browser's grid, drawn from Figma's layers, its thumbnail the caller's and its More a menu of its own; or, as `create`, the tile that adds one (owner decision 2026-09-25: Figma's New Asset Tile, kept as drawn). Pressable where it is given something to do, its name then the stretched action, the card named by it, as its description says."
      },
      {
        "rule": "rename",
        "at": "type",
        "reason": "Figma's values name the component and a tile; in code they are what the tile is, a file or the one that creates one."
      },
      {
        "rule": "follows",
        "at": "root.align",
        "reason": "A file's tile packs its thumbnail and footer from the top; the create tile centres its Plus and label, as Figma draws each."
      },
      {
