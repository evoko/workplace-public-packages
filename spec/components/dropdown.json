    "fileVersion": "2403086052040245261"
  },
  "overlay": {
    "file": "spec/overlay/dropdown.yaml",
    "rules": [
      {
        "rule": "states.rename",
        "at": "pressed → open",
        "reason": "Dropdown's pressed is its open state: the chevron turns up and the field takes the focus ring, as Select's open does (\"state=active is legacy — migrate to pressed\", says its description). The code draws it while the panel is open, as Select's."
      },
      {
        "rule": "base",
        "at": "base",
        "reason": "The same control as Select, in Dropdown's own look (owner decision 2026-09-24): MUI's Select on InputBase on the web, its panel a Dropdown Menu, since Figma draws Dropdown none; a drawn field under a SolarMenuAnchor in Flutter. A leading icon, and a chevron that turns up while open."
      },
      {
        "rule": "bind",
        "at": "field.height",
        "reason": "As Button's height: size.control, one step per size, which SOLAR added on 2026-09-25; Figma leaves the height unbound, which the design review asks SOLAR to bind."
      },
      {
        "rule": "bind",
        "at": "iconChevronDown.width",
        "reason": "As the icons', a step smaller for the chevron."
      },
      {
        "rule": "bind",
        "at": "iconChevronUp.width",
        "reason": "As the down chevron's."
      },
      {
        "rule": "bind",
        "at": "leadingIcon.width",
        "reason": "Same values, governed tokens, a step of the icon ladder per size; the icon's height is already bound to them."
      },
      {
        "rule": "bind",
        "at": "trailingIcon.width",
        "reason": "As the leading icon's."
      },
      {
