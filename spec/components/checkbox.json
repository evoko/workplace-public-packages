    "defaultVariant": "checked=false, disabled=false, hover=false, mixed=false, focus=false",
    "fileVersion": "2402761872194862831"
  },
  "overlay": {
    "file": "spec/overlay/checkbox.yaml",
    "rules": [
      {
        "rule": "base",
        "at": "base",
        "reason": "MUI's Checkbox on the web, for its native input (a form value, a label that toggles it, the mixed state announced), with its box, tick and dash drawn from Figma's layers by the shared helpers. Bespoke in Flutter, whose Checkbox paints a tick of its own and cannot take Figma's: drawn with the same helpers, pressable, and announced as a checkbox."
      },
      {
        "rule": "follows",
        "at": "root.align",
        "reason": "As its direction, the checked box's alone."
      },
      {
        "rule": "follows",
        "at": "root.borderWidth",
        "reason": "A disabled checked box has no edge, checked or mixed, where every other box keeps its border: a filled box that cannot be used is drawn flat."
      },
      {
        "rule": "follows",
        "at": "root.direction",
        "reason": "Only a checked box holds a mark, and only it is an auto layout, centring its tick or dash; the empty box lays nothing out."
      },
      {
        "rule": "follows",
        "at": "root.gap",
        "reason": "As its direction, the checked box's alone."
      },
      {
        "rule": "follows",
        "at": "root.paddingBottom",
        "reason": "As its direction, the checked box's alone."
      },
      {
        "rule": "follows",
        "at": "root.paddingLeft",
        "reason": "As its direction, the checked box's alone."
      },
      {
        "rule": "follows",
        "at": "root.paddingRight",
        "reason": "As its direction, the checked box's alone."
      },
      {
        "rule": "follows",
        "at": "root.paddingTop",
        "reason": "As its direction, the checked box's alone."
      },
      {
        "rule": "set",
        "at": "root.appearance.checked=true, mixed=true.default.borderColor",
        "reason": "The resting mixed box alone is drawn with no edge; the checked box at rest has one, and so does the mixed box on hover. Drawn with the checked box's edge, as every other enabled box is; the design review asks which SOLAR means."
      },
      {
        "rule": "allowLiteral",
        "at": "container.height",
        "reason": "As its width."
      },
      {
        "rule": "allowLiteral",
        "at": "container.width",
        "reason": "The dash's own size, 10 by 2, is its drawing's, as the tick's is."
      },
      {
        "rule": "allowLiteral",
        "at": "icon.height",
        "reason": "As its width."
      },
      {
        "rule": "allowLiteral",
        "at": "icon.width",
        "reason": "The tick's own size, 10 by 7, is its drawing's, as Figma's outline is: a glyph, not an icon from the ladder."
      },
      {
        "rule": "allowLiteral",
        "at": "root.height",
        "reason": "As its width."
      },
      {
        "rule": "allowLiteral",
        "at": "root.width",
        "reason": "The box is 16px, and SOLAR has no control size token (the design review's question on control sizes and the target size); carried as Figma's number."
      },
      {
        "rule": "accept",
        "at": "component.checkbox.root.borderWidth@mixed=true",
        "reason": "As its colour: the resting mixed box keeps the border every other enabled box has."
      },
      {
        "rule": "bind",
        "at": "root.paddingTop, root.paddingRight, root.paddingBottom, root.paddingLeft",
        "reason": "Same value, governed token: a padding Figma leaves unbound at 0 is inset.none, SOLAR's token for no inset. It is the one answer in every component, so it is decided once here and raised with SOLAR once, as a whole, not per component.",
        "from": "spec/overlay/defaults.yaml",
        "default": "zero-insets"
      }
    ]
  }
}
