  },
  "overlay": {
    "file": "spec/overlay/action-card.yaml",
    "rules": [
      {
        "rule": "base",
        "at": "base",
        "reason": "Bespoke on both: a card of the family (shells/card.mjs), drawn from Figma's layers, its calls to action the caller's Buttons and its More a menu of its own; pressable where it is given something to do, its title then the stretched action, its Buttons reachable above it (owner decision 2026-09-25). Its description's \"the surface itself is the control, not a Button-in-a-Card\" is what the stretched title gives, with the Buttons Figma draws."
      },
      {
        "rule": "bind",
        "at": "icon.width",
        "reason": "Same value, governed token; the icon's height is already bound to it."
      },
      {
        "rule": "bind",
        "at": "iconMore.width",
        "reason": "Same value, governed token; the More icon's height is already bound to it."
      },
      {
        "rule": "set",
        "at": "button.base.height",
        "reason": "As the primary Button's, the Button's own height."
      },
      {
        "rule": "set",
        "at": "primaryCTA.base.height",
        "reason": "The calls to action are the caller's Buttons, sm as Figma draws them, whose height is their own: the card places them and never sizes them."
      },
      {
        "rule": "set",
        "at": "root.appearance.status=danger.focus.shadow",
        "reason": "Figma draws Action Card no focus state; its description says focus is Card's. A pressable card, focused on its title, draws SOLAR's focus ring, as Card's does; the design review asks SOLAR to draw it."
      },
      {
        "rule": "set",
        "at": "root.appearance.status=default.focus.shadow",
        "reason": "Figma draws Action Card no focus state; its description says focus is Card's. A pressable card, focused on its title, draws SOLAR's focus ring, as Card's does; the design review asks SOLAR to draw it."
      },
      {
        "rule": "set",
        "at": "root.appearance.status=done.focus.shadow",
        "reason": "Figma draws Action Card no focus state; its description says focus is Card's. A pressable card, focused on its title, draws SOLAR's focus ring, as Card's does; the design review asks SOLAR to draw it."
      },
      {
        "rule": "set",
        "at": "root.base.width",
        "reason": "A card spans the space it is put in: Figma draws it 300 wide, a sample. The caller sizes it."
      },
      {
        "rule": "set",
        "at": "secondaryCTA.base.height",
        "reason": "As the primary Button's, the Button's own height."
      },
      {
        "rule": "set",
        "at": "titleTitle.base.width",
        "reason": "The title fills its row, the More menu at the row's end, as Figma sizes it (FILL): a text's sizing the IR does not read, set here."
      },
      {
        "rule": "samples",
        "at": "layout: vertical",
        "reason": "Figma draws one layout, vertical: an axis of one value is no choice. The API loses it, and gains it when SOLAR draws another."
      },
      {
        "rule": "slots",
        "at": "description → description",
        "reason": "Its words, Figma's example in the content slot, are the caller's; drawn in the secondary ink, as Card's description."
      },
      {
        "rule": "slots",
        "at": "titleTitle → title",
        "reason": "What the action is is the caller's; Figma records no text prop."
      },
      {
        "rule": "bind",
        "at": "title.paddingTop, title.paddingRight, title.paddingBottom, title.paddingLeft, content.paddingTop, content.paddingRight, content.paddingBottom, content.paddingLeft, cta.paddingTop, cta.paddingRight, cta.paddingBottom, cta.paddingLeft",
        "reason": "Same value, governed token: a padding Figma leaves unbound at 0 is inset.none, SOLAR's token for no inset. It is the one answer in every component, so it is decided once here and raised with SOLAR once, as a whole, not per component.",
        "from": "spec/overlay/defaults.yaml",
        "default": "zero-insets"
      }
    ]
  }
