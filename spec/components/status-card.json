    "rules": [
      {
        "rule": "base",
        "at": "base",
        "reason": "Bespoke on both: a card of the family (shells/card.mjs), drawn from Figma's layers, its StatusIndicator composed and its More a menu of its own; pressable where it is given something to do, its title then the stretched action (owner decision 2026-09-25)."
      },
      {
        "rule": "rename",
