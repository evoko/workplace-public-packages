# Generated raw extractions are written by scripts and not reflowed by Prettier.
docs/solar-web/raw/**/*.json
docs/solar/raw/**/*.json
docs/solar-icons/raw/**/*.json
# Exported Figma assets are byte-exact copies.
docs/solar-icons/svg/**
docs/solar-icons/logos/**
# Dart package: formatted by dart format, not Prettier. Its markdown is the exception -- dart
# format does not touch it, and without this it is the one README no check ever reads.
# Files, not folders, so the markdown in nested folders can be let back in.
packages/solar_flutter/**/*
!packages/solar_flutter/**/
!packages/solar_flutter/**/*.md
