{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@bwp-web/styles-css#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!design.ir.json", "!src/index.css"],
      "outputs": ["dist/**", "design.ir.json", "src/index.css"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build:types": {
      "dependsOn": ["^build:types"],
      "outputs": ["dist/**/*.d.ts", "dist/**/*.d.ts.map"]
    },
    "typecheck": {
      "dependsOn": ["^build:types", "^typecheck"]
    },
    "lint": {},
    "@bwp-web/styles-css#lint": {
      "dependsOn": ["@bwp-web/ds-compiler#build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@bwp-web/styles-mui#test": {
      "dependsOn": ["^build", "build"]
    },
    "format": {
      "inputs": ["$TURBO_DEFAULT$", "../../.prettierrc.json"]
    },
    "clean": {
      "cache": false
    }
  }
}
