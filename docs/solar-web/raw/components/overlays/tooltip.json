  "docText": [
    "SOLAR®",
    "Biamp Design System",
    "1.0",
    "Tooltip",
    "Description",
    "Brief contextual label shown on hover or keyboard focus. Never interactive — for interactive overlays use Popover.",
    "Sizes",
    "sm   Icon-button labels and single-word descriptors.\nmd   Multi-word descriptions, up to ~10 words.",
    "Position",
    "top      Default. Use unless it clips.\nbottom   When top clips or anchor sits near top edge.\nleft     When bottom and top clip (rare).\nright    Same — flip when needed.",
    "Timing",
    "Show after 500ms hover delay.\nHide immediately on pointer leave or focus loss.\nShow instantly on keyboard focus (no delay).",
    "Labels & Content",
    "1 line (sm) or ~10 words (md).\nNo links, no buttons, no interactive content.\nPair with aria-describedby on the trigger.",
    "Rules",
    "DO   Use for icon-button labels\nDO   Show instantly on keyboard focus\nDO   Keep content under 10 words\nDO   Pair aria-describedby with trigger",
    "DON'T   Put links or buttons inside\nDON'T   Use as the sole source of critical info\nDON'T   Override with custom long delays\nDON'T   Nest tooltips on tooltips"
  ],
  "pageContext": null
}
