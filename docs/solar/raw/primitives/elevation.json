    {
      "name": "Elevation / Accessibility",
      "title": "Elevation / Accessibility",
      "subtitle": null,
      "x": 3040,
      "y": 0,
      "w": 1440,
      "h": 968,
      "blocks": [
        {
          "t": "p",
          "text": "Elevation visuals must remain perceivable across both modes and for users with reduced contrast sensitivity. Shadows are decorative — they convey hierarchy but never carry the only signal. Every elevated surface still meets WCAG AA contrast for its intended content, and every focus state ships a non-color cue (a 2px ring) on top of the color shift.\n\nWhen running an a11y review on a component that uses elevation, walk the table below.",
          "style": "Body/Body M"
        },
        {
          "t": "group",
          "name": ".Table / Column",
          "blocks": [
            {
              "t": "p",
              "text": "Concern",
              "style": "Body/Body S/Semibold"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Column",
          "blocks": [
            {
              "t": "p",
              "text": "Rule",
              "style": "Body/Body S/Semibold"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Column",
          "blocks": [
            {
              "t": "p",
              "text": "Why",
              "style": "Body/Body S/Semibold"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Surface contrast",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Body text on surface/raised + surface/overlay + surface/dialog must meet AA (4.5:1) in both modes — verified against color/text/primary.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Elevated surfaces use mode-paired primitives; verify after every primitive rebind.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Focus ring",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Focus is signalled by shadow/focus/* + the 2px ring (non-color cue). Color alone is never the focus signal.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "WCAG 2.4.7 + 1.4.11. Users with color-vision deficiency rely on the geometric cue.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Danger emphasis",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "shadow/danger and shadow/focus/danger reinforce — they don't replace — the danger surface or border. Remove either and the state still reads.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "WCAG 1.4.1 (don't rely on color alone).",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Dialog backdrop",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "shadow/dialog must pair with surface/scrim. Bare shadow on a busy page collapses figure–ground separation.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Modal content needs a calm backdrop to be reliably readable.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Dark-mode shadow alpha",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "shadow/subtle and shadow/strong shift alpha in dark mode (5%→50%, 20%→70%). Verify shadows still read after a mode swap.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Dark surfaces eat low-alpha shadows; the alpha shift restores the lift cue.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Stacking",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Tooltip > Toast > Dialog > Overlay > Dropdown > Sticky > Base. Encoded in the z-index ladder (CLAUDE.md §6); never override. Drawer content sits at --solar-z-dialog; backdrop at --solar-z-overlay.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Mis-stacked elevation traps focus under an opaque scrim — keyboard users get stuck. Tooltip outranks Toast so a tooltip on a notification stays readable.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Reduced motion",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "If a component uses both shadow and motion to enter (e.g., toast slide + lift), prefers-reduced-motion replaces the slide; the shadow stays.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Elevation cue is information; the slide is decoration.",
              "style": "Body/Body S/Medium"
            }
          ]
        }
      ]
    }
  ],
