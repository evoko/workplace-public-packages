      "blocks": [
        {
          "t": "p",
          "text": "Easing tokens define the acceleration curves used for transitions and animations across interface components. They control how motion feels — whether elements accelerate, decelerate, or both — ensuring interactions feel natural and consistent throughout the system. Easing values should be applied through semantic motion tokens rather than directly using raw cubic-bezier values.",
          "style": "16/400"
        },
