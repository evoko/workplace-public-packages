    {
      "name": "Motion / Reduced motion",
      "title": "Motion / Reduced motion",
      "subtitle": null,
      "x": 5120,
      "y": 0,
      "w": 1440,
      "h": 896,
      "blocks": [
        {
          "t": "p",
          "text": "All motion must honor prefers-reduced-motion: reduce. When the user requests reduced motion, every duration resolves to motion/duration/instant (0ms) and decorative motion is removed entirely. State changes still happen — they just happen instantly.\n\nThis page documents the contract every component is expected to meet. Verify it during a11y review before any motion-using component graduates to 🟢.",
          "style": "Body/Body M"
        },
        {
          "t": "group",
          "name": ".Table / Column",
          "blocks": [
            {
              "t": "p",
              "text": "Class of motion",
              "style": "Body/Body S/Semibold"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Column",
          "blocks": [
            {
              "t": "p",
              "text": "Behavior under prefers-reduced-motion",
              "style": "Body/Body S/Semibold"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Column",
          "blocks": [
            {
              "t": "p",
              "text": "Examples",
              "style": "Body/Body S/Semibold"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Functional state change",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Keep — but collapse to 0ms via motion/duration/instant. The user must still see the state has changed.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Hover ring appears, dropdown opens, tab switches, checkbox checks, focus ring shows.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Decorative motion",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Remove. Don't ship as instant; ship as absent.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Loading spinner pulses, hero parallax, count-up animations, ambient floats.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Position change (slide / pan)",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Replace with opacity-only fade at instant duration. Don't translate.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Toast slide-in, drawer slide, page transition, sheet enter.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Size or layout change",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Snap to final size. No tween.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Accordion expand, expandable card, panel resize.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Implementation",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "@media (prefers-reduced-motion: reduce) { * { transition-duration: 0ms !important; transition-delay: 0ms !important; scroll-behavior: auto !important; } }. Decorative loops: set animation: none on the component (don't ship as instant — ship as absent). Transforms still need explicit transition: none per component.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Universal media-query baseline + per-component opt-outs for transforms and decorative animations.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Verification",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "QA tests every motion-using component twice — once normal, once with prefers-reduced-motion: reduce. Screenshot diff both.",
              "style": "Body/Body S/Medium"
            }
          ]
        },
        {
          "t": "group",
          "name": ".Table / Row",
          "blocks": [
            {
              "t": "p",
              "text": "Toast, Drawer, Dropdown, Tooltip, Spinner, all dialogs.",
              "style": "Body/Body S/Medium"
            }
          ]
        }
      ]
    }
  ],
