{
  "name": "workplace-public-packages",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint --continue",
    "lint:fix": "turbo run lint -- --fix",
    "format": "turbo run format --continue",
    "format:fix": "turbo run format -- --write",
    "storybook": "turbo run dev --filter=@bwp-web/storybook",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@storybook/addon-vitest": "^10.6.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^24.20.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0"
}
