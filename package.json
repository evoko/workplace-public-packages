{
  "name": "workplace-public-packages",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint --continue",
    "lint:fix": "turbo run lint -- --fix",
    "format": "turbo run format --continue",
    "format:fix": "turbo run format -- --write",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "solar:sync": "node scripts/solar-sync.mjs",
    "solar:foundations": "node docs/solar/raw/fetch-rest.mjs && node docs/solar/build-docs.mjs",
    "solar:web": "node docs/solar-web/raw/fetch-rest.mjs && node docs/solar-web/build-docs.mjs",
    "solar:icons": "node docs/solar-icons/raw/fetch-rest.mjs && node docs/solar-icons/build-docs.mjs",
    "solar:fetch": "node docs/solar/raw/fetch-rest.mjs && node docs/solar-web/raw/fetch-rest.mjs && node docs/solar-icons/raw/fetch-rest.mjs",
    "solar:docs": "node docs/solar/build-docs.mjs && node docs/solar-web/build-docs.mjs && node docs/solar-icons/build-docs.mjs",
    "solar:tokens": "node docs/solar/tokens/build-derived.mjs",
    "solar:codegen": "node packages/codegen/bin/solar-codegen.mjs",
    "solar:rebuild": "node scripts/solar-sync.mjs --no-fetch",
    "solar:scaffold": "node packages/codegen/bin/solar-scaffold.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.0"
}
