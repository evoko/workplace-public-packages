{
  "name": "workplace-public-packages",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint --continue",
    "lint:fix": "turbo run lint -- --fix",
    "format": "turbo run format --continue",
    "format:fix": "turbo run format -- --write",
    "storybook": "turbo run dev --filter=@bwp-web/storybook",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "ds": "bwp-ds --root packages/styles-css",
    "verify": "bwp-ds verify --root packages/styles-css",
    "verify:rendered": "bwp-ds verify --root packages/styles-css --rendered",
    "storybook:test": "turbo run test:rendered --filter=@bwp-web/storybook",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@storybook/addon-vitest": "^10.3.5",
    "turbo": "^2.9.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.0"
}
