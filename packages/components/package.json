{
  "name": "@bwp-web/components",
  "version": "2.0.0-alpha.0",
  "description": "Shared Biamp Workplace React components (SOLAR)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "clean": "rm -rf dist node_modules .turbo",
    "prepublishOnly": "npm run build",
    "test:visual": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet"
  },
  "devDependencies": {
    "@bwp-web/eslint-config": "*",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "storybook-addon-pseudo-states": "^10.6.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evoko/workplace-public-packages.git",
    "directory": "packages/components"
  },
  "dependencies": {
    "@bwp-web/assets": "^2.0.0-alpha.0",
    "@bwp-web/styles": "^2.0.0-alpha.0"
  },
  "peerDependencies": {
    "@mui/material": "^9.0.0",
    "react": ">=18"
  }
}
