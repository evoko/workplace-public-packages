{
  "name": "@bwp-web/styles",
  "version": "1.1.0",
  "description": "Shared Biamp Workplace theme and styling utilities built on MUI",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./mui-theme-augmentation": "./mui-theme-augmentation.d.ts"
  },
  "files": [
    "dist",
    "mui-theme-augmentation.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "clean": "rm -rf dist node_modules .turbo",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@bwp-web/assets": "^1.0.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.0.0",
    "@mui/x-date-pickers": "^8.6.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=24.20.0",
    "npm": ">=11.19.0"
  },
  "devDependencies": {
    "@bwp-web/assets": "*",
    "@bwp-web/eslint-config": "*",
    "@mui/material": "^7.3.10",
    "@mui/x-date-pickers": "^8.28.3",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.2",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evoko/workplace-public-packages.git",
    "directory": "packages/styles"
  }
}
